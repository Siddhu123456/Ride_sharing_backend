--Functions to update cart_item total based on units
CREATE OR REPLACE FUNCTION update_cart_item_total_amount()
RETURNS TRIGGER AS $$
DECLARE
    vp_price NUMERIC;
BEGIN
    -- Fetch the current vendor product price
    SELECT price INTO vp_price
    FROM vendor_product
    WHERE vendor_product_id = NEW.vendor_product_id;

    -- Update unit_price (same logic as old total_amount = units * price)
    NEW.unit_price := vp_price;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER upd_cart_item_total
BEFORE INSERT OR UPDATE ON cart_items
FOR EACH ROW
EXECUTE FUNCTION update_cart_item_total_amount();


DROP PROCEDURE IF EXISTS place_single_product_order;

CREATE OR REPLACE PROCEDURE place_single_product_order(
    p_user_id INT,
    p_address_id INT,
    p_vendor_product_id INT,
    p_units INT,
    p_payment_mode VARCHAR(50)
)
LANGUAGE plpgsql
AS $$
DECLARE
    p_order_id INT;
    p_suborder_id INT;
    p_warehouse_id INT;
    p_vendor_id INT;
    p_price NUMERIC(12,2);
    p_total_amount NUMERIC(14,2);
BEGIN
    -- Get price
    SELECT price INTO p_price
    FROM vendor_product
    WHERE vendor_product_id = p_vendor_product_id;

    p_total_amount := p_price * p_units;

    -- Create order
    INSERT INTO orders (user_id, address_id, ord_status, total_amount, payment_mode, created_at)
    VALUES (p_user_id, p_address_id, 'created', p_total_amount, p_payment_mode, now())
    RETURNING order_id INTO p_order_id;

    -- Get vendor_id
    SELECT vendor_id INTO p_vendor_id
    FROM vendor_product
    WHERE vendor_product_id = p_vendor_product_id;

    -- Get warehouse (any warehouse that holds this product)
    SELECT warehouse_id INTO p_warehouse_id
    FROM inventory
    WHERE vendor_product_id = p_vendor_product_id
    LIMIT 1;

    -- Create suborder
    INSERT INTO suborders(order_id, vendor_id, warehouse_id, suborder_total_amount, ord_status)
    VALUES (p_order_id, p_vendor_id, p_warehouse_id, p_total_amount, 'created')
    RETURNING suborder_id INTO p_suborder_id;

    -- Create order item
    INSERT INTO order_items(suborder_id, vendor_product_id, prod_snapshot_name, item_price, units)
    SELECT 
        p_suborder_id,
        vp.vendor_product_id,
        vp.vendor_sku,
        p_price,
        p_units
    FROM vendor_product vp
    WHERE vp.vendor_product_id = p_vendor_product_id;

END;
$$;


DROP PROCEDURE IF EXISTS place_order_cart;
CREATE OR REPLACE PROCEDURE place_order_cart(
    p_user_id INT,
    p_address_id INT,
    p_payment_mode VARCHAR(50)
)
LANGUAGE plpgsql
AS $$
DECLARE
    p_order_id INT;
    p_total_amount NUMERIC(14,2);
    rec RECORD;
    v_suborder_id INT;
BEGIN
    -- 1) compute total from cart_items (units * unit_price)
    SELECT COALESCE(SUM(ci.units * ci.unit_price),0) INTO p_total_amount
    FROM cart_items ci
    JOIN carts c ON ci.cart_id = c.cart_id
    WHERE c.user_id = p_user_id;

    IF p_total_amount <= 0 THEN
        RAISE EXCEPTION 'Cart empty for user %', p_user_id;
    END IF;

    -- 2) create order
    INSERT INTO orders(user_id, address_id, ord_status, total_amount, payment_mode, created_at)
    VALUES (p_user_id, p_address_id, 'created', p_total_amount, p_payment_mode, now())
    RETURNING order_id INTO p_order_id;

    /*
      3) Build mapping: for each cart item determine vendor_id and the selected_warehouse
         (warehouse having highest avl_quantity for that vendor_product).
         Then aggregate by (vendor_id, selected_warehouse) to create suborders.
    */
    FOR rec IN
        WITH cart_with_wh AS (
            SELECT
                ci.cart_id,
                ci.vendor_product_id,
                ci.units,
                ci.unit_price,
                vp.vendor_id,
                -- choose the warehouse with highest available quantity for this vendor_product
                ( SELECT i.warehouse_id
                  FROM inventory i
                  WHERE i.vendor_product_id = ci.vendor_product_id
                  ORDER BY i.avl_quantity DESC
                  LIMIT 1
                ) AS selected_warehouse,
                (ci.units * ci.unit_price) AS line_total
            FROM cart_items ci
            JOIN carts c ON ci.cart_id = c.cart_id
            JOIN vendor_product vp ON ci.vendor_product_id = vp.vendor_product_id
            WHERE c.user_id = p_user_id
        )
        SELECT
            vendor_id,
            selected_warehouse AS warehouse_id,
            SUM(line_total) AS sub_total
        FROM cart_with_wh
        GROUP BY vendor_id, selected_warehouse
    LOOP
        -- sanity check
        IF rec.warehouse_id IS NULL THEN
            RAISE EXCEPTION 'No inventory row found for one or more cart items (user=%)', p_user_id;
        END IF;

        -- create suborder for this vendor + warehouse
        INSERT INTO suborders(order_id, vendor_id, warehouse_id, suborder_total_amount, ord_status)
        VALUES (p_order_id, rec.vendor_id, rec.warehouse_id, rec.sub_total, 'created')
        RETURNING suborder_id INTO v_suborder_id;

        -- move matching cart_items -> order_items (prod_snapshot_name set to vendor_sku)
        INSERT INTO order_items(suborder_id, vendor_product_id, prod_snapshot_name, item_price, units)
        SELECT
            v_suborder_id,
            ci.vendor_product_id,
            vp.vendor_sku,
            ci.unit_price,
            ci.units
        FROM cart_items ci
        JOIN carts c ON ci.cart_id = c.cart_id
        JOIN vendor_product vp ON ci.vendor_product_id = vp.vendor_product_id
        WHERE c.user_id = p_user_id
          AND vp.vendor_id = rec.vendor_id
          AND (
              SELECT i.warehouse_id
              FROM inventory i
              WHERE i.vendor_product_id = ci.vendor_product_id
              ORDER BY i.avl_quantity DESC
              LIMIT 1
          ) = rec.warehouse_id;

        -- recompute and set suborder_total_amount from inserted rows (defensive)
        UPDATE suborders
        SET suborder_total_amount = COALESCE((
                SELECT SUM(oi.units * oi.item_price)
                FROM order_items oi
                WHERE oi.suborder_id = v_suborder_id
            ), 0)
        WHERE suborder_id = v_suborder_id;

        -- delete those cart_items (they've been moved)
        DELETE FROM cart_items
        WHERE cart_id IN (SELECT cart_id FROM carts WHERE user_id = p_user_id)
          AND vendor_product_id IN (
              SELECT ci.vendor_product_id
              FROM cart_items ci
              JOIN carts c ON ci.cart_id = c.cart_id
              JOIN vendor_product vp ON ci.vendor_product_id = vp.vendor_product_id
              WHERE c.user_id = p_user_id
                AND vp.vendor_id = rec.vendor_id
                AND (
                    SELECT i.warehouse_id
                    FROM inventory i
                    WHERE i.vendor_product_id = ci.vendor_product_id
                    ORDER BY i.avl_quantity DESC
                    LIMIT 1
                ) = rec.warehouse_id
          );

    END LOOP;

    -- done
END;
$$;

