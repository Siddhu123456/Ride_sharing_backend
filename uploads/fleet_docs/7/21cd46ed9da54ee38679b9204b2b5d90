--Trigger to reduce inventory stock
CREATE OR REPLACE FUNCTION reduce_inventory_after_order()
RETURNS TRIGGER AS $$
DECLARE
    wh_id INTEGER;
BEGIN
    -- Get the warehouse for this suborder
    SELECT warehouse_id INTO wh_id
    FROM suborders
    WHERE suborder_id = NEW.suborder_id;

    -- Reduce inventory for that vendor_product in that warehouse
    UPDATE inventory
    SET avl_quantity = avl_quantity - NEW.units
    WHERE vendor_product_id = NEW.vendor_product_id
      AND warehouse_id = wh_id;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER red_inventory_order
AFTER INSERT ON order_items
FOR EACH ROW
EXECUTE FUNCTION reduce_inventory_after_order();

